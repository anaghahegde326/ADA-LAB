#include <stdio.h>

#define MAX 10

int mobile(int a[], int dir[], int n) {
    int mobile_prev = 0, mobile_index = -1;

    for (int i = 0; i < n; i++) {
        if (dir[i] == 0 && i != 0) {
            if (a[i] > a[i - 1] && a[i] > mobile_prev) {
                mobile_prev = a[i];
                mobile_index = i;
            }
        }

        if (dir[i] == 1 && i != n - 1) {
            if (a[i] > a[i + 1] && a[i] > mobile_prev) {
                mobile_prev = a[i];
                mobile_index = i;
            }
        }
    }

    return mobile_index;
}

void printPermutation(int a[], int n) {
    for (int i = 0; i < n; i++) {
        printf("%d ", a[i]);
    }
    printf("\n");
}

int main() {
    int n;
    int a[MAX], dir[MAX];

    printf("Enter number of elements: ");
    scanf("%d", &n);

    for (int i = 0; i < n; i++) {
        a[i] = i + 1;
        dir[i] = 0;
    }

    printPermutation(a, n);

    while (1) {
        int m = mobile(a, dir, n);

        if (m == -1)
            break;

        if (dir[m] == 0) {
            int temp = a[m];
            a[m] = a[m - 1];
            a[m - 1] = temp;

            temp = dir[m];
            dir[m] = dir[m - 1];
            dir[m - 1] = temp;

            m = m - 1;
        } else {
            int temp = a[m];
            a[m] = a[m + 1];
            a[m + 1] = temp;

            temp = dir[m];
            dir[m] = dir[m + 1];
            dir[m + 1] = temp;

            m = m + 1;
        }

        for (int i = 0; i < n; i++) {
            if (a[i] > a[m]) {
                dir[i] = 1 - dir[i];
            }
        }

        printPermutation(a, n);
    }

    return 0;
}
